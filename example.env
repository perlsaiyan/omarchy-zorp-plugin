# Optional. Copy to ~/.config/omarchy/zorp-mail.env to change the defaults.
#
#   install -m 644 example.env ~/.config/omarchy/zorp-mail.env

# Folders to count and list, space-separated: well-known names (inbox,
# archive, junkemail, ...) or display names, as in zorp's notify.folders.
# The count is the unread mail zorp has cached for these folders, so unread
# mail older than its sync window isn't counted.
#FOLDERS="inbox"

# How many of the newest messages the card lists.
#LIMIT=8
